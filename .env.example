# NAS File Monitoring System Configuration

# Monitoring target directory (default: /media/requisition/Report)
NAS_DIRECTORY=/media/requisition/Report

# Database connection URL (SQLite3)
DATABASE_URL=sqlite:///data/nas_monitor.db

# Periodic scan interval in seconds (default: 60)
SCAN_INTERVAL=60

# File content hash algorithm (sha256)
HASH_ALGORITHM=sha256

# Seconds to wait for file size/mtime stability (detect partial copy/transfers)
FILE_STABILITY_SECONDS=5

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application server settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Brother MFC-L6900DW Integration
PRINTER_ENABLED=true
PRINTER_HOST=192.168.4.171
PRINTER_PASSWORD=initpass
PRINTER_POLL_INTERVAL=120
PRINTER_SYSLOG_ENABLED=true
PRINTER_SYSLOG_HOST=0.0.0.0
PRINTER_SYSLOG_PORT=1514

# OpenLDAP User Authentication & Directory Integration
LDAP_ENABLED=true
LDAP_SERVER=192.168.1.19
LDAP_PORT=389
LDAP_BASE_DN=dc=aikhanlab,dc=com
